{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nphard",
  "compatibility_date": "2026-09-07",

  // Only /api/* reaches this script; static files answer before it runs. It
  // still works with no database attached — the endpoints report themselves
  // switched off and the page hides its results panels — so a provisioning
  // failure costs the stats, never the puzzles.
  "main": "worker/index.ts",

  // The built site. Without this file at all, wrangler treats the first deploy
  // as an unconfigured project, runs its setup wizard, and tries to wire
  // @cloudflare/vite-plugin into vite.config.ts — which this project does not
  // need, and which fails.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Not "single-page-application". Assets are built with a relative base
    // (vite.config.ts) so the same output also works from a subpath on GitHub
    // Pages. Serving index.html for an unknown path would then resolve
    // ./assets/... against that path and hand back a blank page; a plain 404 is
    // the honest answer for a site with exactly one route.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  // Daily result stats.
  //
  // The id is pinned deliberately. Wrangler can provision a database from the
  // name alone, but when the build token lacks D1 permission it reads that as
  // permission denied, silently skips provisioning and deploys anyway — which
  // is a green build and a Worker with no STATS binding, and /api/stats
  // answering {"enabled": false}. With a real id there is nothing left to
  // provision, so the build token's D1 permissions stop mattering.
  //
  // `npx wrangler d1 list` prints the id if this ever needs re-pinning; the
  // database itself is created once, by hand, and never by a deploy.
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "hardmode-stats",
      "database_id": "96573f70-a72a-4ac9-baba-2f604c474c04"
    }
  ]
}
