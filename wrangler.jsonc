{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nphard",
  "compatibility_date": "2026-09-07",

  // Only /api/* reaches this script; static files answer before it runs. It
  // still works with no database attached — the endpoints report themselves
  // switched off and the page hides its results panels — so a provisioning
  // failure costs the stats, never the puzzles.
  "main": "worker/index.ts",

  // The built site. Without this file at all, wrangler treats the first deploy
  // as an unconfigured project, runs its setup wizard, and tries to wire
  // @cloudflare/vite-plugin into vite.config.ts — which this project does not
  // need, and which fails.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Not "single-page-application". Assets are built with a relative base
    // (vite.config.ts) so the same output also works from a subpath on GitHub
    // Pages. Serving index.html for an unknown path would then resolve
    // ./assets/... against that path and hand back a blank page; a plain 404 is
    // the honest answer for a site with exactly one route.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  // Daily result stats. The binding deliberately carries no database_id:
  // wrangler provisions a D1 database named below on the first deploy that
  // needs one, and every later deploy inherits it from the deployed Worker's
  // own settings rather than creating another. That keeps this working in CI,
  // where wrangler's write-back of the new id into this file is thrown away
  // with the checkout.
  //
  // If provisioning is ever refused, the fix is two commands:
  //   npx wrangler d1 create hardmode-stats
  // then paste the printed id in as "database_id" here.
  "d1_databases": [
    { "binding": "STATS", "database_name": "hardmode-stats" }
  ]
}
